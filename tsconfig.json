{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "noEmit": true,
        "types": ["miniprogram-api-typings"],
        "lib": ["ES2020"],
        "skipLibCheck": true
    },
    "include": ["libs/**/*.d.ts"],
    "exclude": ["node_modules", "sample-*", "miniprogram_npm"]
}
